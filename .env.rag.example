# Retrieval-only module. Copy to .env.rag and fill from the embedding owner.
# Loaded by `python -m examples.retrieve`, or export these into your backend process.
EMBEDDING_PROVIDER=api
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_BASE_URL=https://llm-o72xf06lk2b2rmtr.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
# Measured with the selected model on 2026-11-10; changing models requires revalidation.
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=10
EMBEDDING_TIMEOUT_S=30
EMBEDDING_MAX_RETRIES=3
DOCUMENT_RETRIEVAL_ENABLED=true
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# New machine: no untracked local history. Successful calls/cache are persisted.
EMBEDDING_TOKEN_LIMIT=1000000
EMBEDDING_UNTRACKED_RESERVE=0
EMBEDDING_CACHE_ENABLED=true
