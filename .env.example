# Copy to .env. Keys stay on the server and must never be committed.
APP_ENV=prod
APP_VERSION=dev
DEMO_MODE=true
ADMIN_TOKEN=

# OpenAI-compatible chat API. Include /v1 in the base URL when required.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_JSON_MODE=true
# DeepSeek: disabled for direct answers; leave blank for APIs without this parameter.
LLM_THINKING=
LLM_TRUST_ENV=true

# Supply your workspace's compatible base URL and key. A different endpoint
# from data/corpus/all-documents-v3/embeddings.json needs an explicit rebuild.
EMBEDDING_PROVIDER=api
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=10
EMBEDDING_TIMEOUT_S=30
EMBEDDING_MAX_RETRIES=2
EMBEDDING_CACHE_ENABLED=true
EMBEDDING_TOKEN_LIMIT=1000000
EMBEDDING_UNTRACKED_RESERVE=0
DOCUMENT_RETRIEVAL_ENABLED=true

# Separate from the old checkout's running containers and ports.
COMPOSE_PROJECT_NAME=campus-graphrag2
WEB_PORT=8081
NEO4J_PASSWORD=
NEO4J_IMAGE_TAG=5.26.0-community
NEO4J_MEM_LIMIT=2g
NEO4J_HEAP=512m
NEO4J_PAGECACHE=512m
API_MEM_LIMIT=2g
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
NPM_REGISTRY=https://registry.npmmirror.com
