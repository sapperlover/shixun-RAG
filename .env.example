# 复制为 .env 后修改：cp .env.example .env
# .env 含密码，不进 git。部署相关的值放这里；算法参数放 config/settings.yaml。

# prod：交付基线；dev：开发叠加会自动覆盖为 dev（允许调试头 X-Debug-Force-Status）
APP_ENV=prod
APP_VERSION=dev

# Neo4j 5 要求密码至少 8 位
NEO4J_PASSWORD=change-me-please

# 镜像标签（V1.2 附录 D.2 候选基线；实测后把 digest 记入 docs/BASELINE.md）
NEO4J_IMAGE_TAG=5.26.0-community
OLLAMA_IMAGE_TAG=0.5.7

# 模型（低配降级：qwen2.5:0.5b 或模板生成，变更需记录）
LLM_MODEL=qwen2.5:1.5b
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 国内下载 HuggingFace 模型用镜像
HF_ENDPOINT=https://hf-mirror.com

# 对外端口（只有 web 暴露）
WEB_PORT=8080

# 资源限制
API_MEM_LIMIT=3g
NEO4J_MEM_LIMIT=2g
NEO4J_HEAP=1g
NEO4J_PAGECACHE=512m
OLLAMA_MEM_LIMIT=6g

# 依赖源（国内可改为 https://pypi.tuna.tsinghua.edu.cn/simple 与 https://registry.npmmirror.com）
PIP_INDEX_URL=https://pypi.org/simple
NPM_REGISTRY=https://registry.npmjs.org
